{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reproforge.dev/schemas/intake-source.schema.json",
  "title": "ReproForge Intake Source Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_url", "source_kind", "authoritative", "captured_at", "arxiv_id", "canonical_url", "title", "authors", "abstract"],
  "properties": {
    "source_url": {"type": "string", "format": "uri"},
    "source_kind": {"enum": ["arxiv", "secondary_mirror", "publisher", "other"]},
    "authoritative": {"type": "boolean"},
    "captured_at": {"type": "string", "minLength": 1},
    "arxiv_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "abstract": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
