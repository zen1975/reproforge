{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reproforge.dev/schemas/candidate-queue.schema.json",
  "title": "ReproForge Candidate Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "screening_window",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "screening_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arxiv_id",
          "title",
          "submitted_on",
          "source_url",
          "source_verified",
          "priority",
          "candidate_capability",
          "why_reusable",
          "free_light_fit",
          "next_gate",
          "status"
        ],
        "properties": {
          "arxiv_id": {
            "type": "string",
            "pattern": "^[0-9]{4}\\.[0-9]{5}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "submitted_on": {
            "type": "string",
            "format": "date"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_verified": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "A+",
              "A",
              "A-",
              "B"
            ]
          },
          "candidate_capability": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "why_reusable": {
            "type": "string",
            "minLength": 1
          },
          "free_light_fit": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "next_gate": {
            "enum": [
              "PDF_PROTOCOL_REVIEW",
              "LICENSE_ASSET_REVIEW",
              "MECHANISM_DESIGN",
              "DEFER"
            ]
          },
          "status": {
            "enum": [
              "SOURCE_VERIFIED",
              "PDF_REVIEWED",
              "PROMOTED_TO_STUDY",
              "DEFERRED",
              "REJECTED"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
